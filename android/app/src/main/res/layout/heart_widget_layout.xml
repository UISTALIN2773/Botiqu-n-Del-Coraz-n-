<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg_card">

    <!-- Partner Photo / Couple Avatar Frame -->
    <RelativeLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/widget_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_launcher_round"
            android:scaleType="centerCrop"
            android:contentDescription="Foto de Pareja" />

        <!-- Floating Mini Pulsing Heart -->
        <ImageView
            android:id="@+id/widget_heart_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_heart"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:contentDescription="Corazón" />
    </RelativeLayout>

    <!-- Center Column: Dynamic Text, Days, and Loving Quote -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/widget_author_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi Amor • Día 450 Juntos ❤️"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#E11D48"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_quote_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tócame si me extrañas o tienes ansiedad."
            android:textSize="11sp"
            android:textColor="#0F172A"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Right Quick Action: Direct Audio Play / WhatsApp Voice Note Button -->
    <LinearLayout
        android:id="@+id/widget_play_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="#E11D48"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/widget_play_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
